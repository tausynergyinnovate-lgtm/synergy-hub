# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# server only — used by the calendar feed (/api/ics). Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic Console → API Keys — powers the AI assistant (server only)
ANTHROPIC_API_KEY=sk-ant-...
# optional override
# ANTHROPIC_MODEL=claude-sonnet-5-5

# local preview with sample data, no accounts needed: NEXT_PUBLIC_DEMO=1 npm run dev
